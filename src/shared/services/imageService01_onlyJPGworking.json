import { CompressionLevel } from '@/hooks/useUserPreferences';

interface CompressionOptions {
  quality: number;               // Normalized scale between 0.1 and 1.0
  targetFormat?: string;         // 'image/jpeg' | 'image/png' | 'image/webp'
  stripMetadata?: boolean;       // Set to true for complete privacy cleanup
  onProgress?: (progress: number) => void;
}

/**
 * Maps application compression presets directly to internal raw numeric canvas scales.
 */
export function mapPresetToQuality(level: CompressionLevel): number {
  switch (level) {
    case 'maximum': return 0.4;   // Extreme optimization
    case 'balanced': return 0.7;  // Optimal weight-to-clarity matrix
    case 'high': return 0.95;     // Premium high fidelity retention
    default: return 0.7;
  }
}

/**
 * Service Layer - Handles client-side canvas-driven memory processing 
 * and explicit EXIF segment dropping.
 */
export class ImageService {
  /**
   * Core execution pipeline converting raw input files into optimized output streams.
   */
  public static async compressImage(file: File, options: CompressionOptions): Promise<Blob> {
    const { quality, targetFormat = file.type, stripMetadata = true, onProgress } = options;

    if (onProgress) onProgress(10);

    return new Promise((resolve, reject) => {
      const reader = new FileReader();

      reader.onload = (event) => {
        if (onProgress) onProgress(30);
        
        const img = new Image();
        img.onload = () => {
          if (onProgress) onProgress(50);

          try {
            const canvas = document.createElement('canvas');
            const ctx = canvas.getContext('2d');

            if (!ctx) {
              throw new Error('Failed to capture native 2D canvas execution context.');
            }

            // Transferring dimensional bounds onto layout sandbox
            canvas.width = img.width;
            canvas.height = img.height;

            // Handle alpha transparency backdrop for JPEG conversions
            if (targetFormat === 'image/jpeg') {
              ctx.fillStyle = '#ffffff';
              ctx.fillRect(0, 0, canvas.width, canvas.height);
            }

            ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
            if (onProgress) onProgress(70);

            // Export raw optimized blob matrix
            canvas.toBlob(
              async (blob) => {
                if (!blob) {
                  reject(new Error('Canvas buffer stream compression resulted in empty binary.'));
                  return;
                }

                if (onProgress) onProgress(90);

                // Privacy Layer: Drop metadata headers if required
                const finalBlob = stripMetadata ? await this.stripMetadataArray(blob) : blob;

                if (onProgress) onProgress(100);
                resolve(finalBlob);
              },
              targetFormat,
              targetFormat === 'image/png' ? undefined : quality // PNG ignores quality float values natively
            );
          } catch (err) {
            reject(err);
          }
        };

        img.onerror = () => reject(new Error('Failed to compile local image memory pointer.'));
        img.src = event.target?.result as string;
      };

      reader.onerror = () => reject(new Error('FileReader crashed during binary stream extraction.'));
      reader.readAsDataURL(file);
    });
  }

  /**
   * EXIF Metadata Stripper - Extracts raw pixel frames while completely drops 
   * GPS, camera logs, and sensitive metadata headers.
   */
  private static async stripMetadataArray(inputBlob: Blob): Promise<Blob> {
    try {
      const arrayBuffer = await inputBlob.arrayBuffer();
      const view = new DataView(arrayBuffer);

      // Verify authentic JPEG header signature
      if (view.getUint16(0, false) !== 0xffd8) {
        return inputBlob; // Return fallback unchanged if format doesn't contain EXIF architecture
      }

      let offset = 2;
      const length = arrayBuffer.byteLength;
      const cleanSegments: ArrayBuffer[] = [arrayBuffer.slice(0, 2)];

      while (offset < length) {
        const marker = view.getUint16(offset, false);
        
        // Break instantly if hitting core compression boundary frames
        if (marker === 0xffda || marker === 0xffd9) {
          cleanSegments.push(arrayBuffer.slice(offset));
          break;
        }

        const segmentLength = view.getUint16(offset + 2, false);
        const nextOffset = offset + 2 + segmentLength;

        // Strip APP1 (0xFFE1 = EXIF) and APP2 (0xFFE2 = ICC Profile/Metadata variations)
        if (marker !== 0xffe1 && marker !== 0xffe2) {
          cleanSegments.push(arrayBuffer.slice(offset, nextOffset));
        }

        offset = nextOffset;
      }

      return new Blob(cleanSegments, { type: inputBlob.type });
    } catch (error) {
      console.error('Metadata parsing failure, returning base memory blob instead:', error);
      return inputBlob;
    }
  }
}
