import * as Muxer from 'mp4-muxer';

export interface VideoCompressionOptions {
  bitrateTargetKbps?: number;
  resolutionScale?: 0.5 | 0.75 | 1.0;
  onProgress?: (progress: number, estimatedSecondsLeft: number) => void;
}

export class VideoService {
  /**
   * Predictive Time Estimator - Calculates remaining seconds
   * based on ongoing sequential playback compression speed.
   */
  public static calculateTimeRemaining(
    currentProgress: number,
    startTimeMs: number,
    totalSizeInBytes: number
  ): number {
    if (currentProgress <= 5) return Math.ceil(totalSizeInBytes / (1024 * 1024 * 5));
    const timeElapsedMs = Date.now() - startTimeMs;
    const progressVelocity = currentProgress / timeElapsedMs;
    const percentageRemaining = 100 - currentProgress;
    return Math.max(Math.ceil(percentageRemaining / progressVelocity / 1000), 1);
  }

  /**
   * High-Performance 4K Resilient Video/Audio WebCodecs and mp4-muxer layout pipeline.
   */
  public static async compressVideo(
    file: File,
    options: VideoCompressionOptions = {}
  ): Promise<Blob> {
    const { onProgress, resolutionScale = 0.75, bitrateTargetKbps = 2500 } = options;
    const startTime = Date.now();

    return new Promise((resolve, reject) => {
      const video = document.createElement('video');
      video.src = URL.createObjectURL(file);
      video.muted = false;
      video.playsInline = true;
      video.playbackRate = 1.0;

      video.onloadedmetadata = async () => {
        const targetWidth = Math.round((video.videoWidth * resolutionScale) / 2) * 2;
        const targetHeight = Math.round((video.videoHeight * resolutionScale) / 2) * 2;

        const canvas = document.createElement('canvas');
        canvas.width = targetWidth;
        canvas.height = targetHeight;
        const ctx = canvas.getContext('2d');
        if (!ctx) return reject(new Error('Canvas context buffer allocation failed.'));

        const muxer = new Muxer.Muxer({
          target: new Muxer.ArrayBufferTarget(),
          video: { codec: 'avc', width: targetWidth, height: targetHeight },
          audio: { codec: 'aac', numberOfChannels: 2, sampleRate: 44100 },
          fastStart: 'in-memory',
          firstTimestampBehavior: 'offset',
        });

        const videoEncoder = new VideoEncoder({
          output: (chunk, metadata) => muxer.addVideoChunk(chunk, metadata),
          error: (err) => reject(err),
        });
        videoEncoder.configure({
          codec: 'avc1.640033', // Upgraded to High Profile Level 5.1 to seamlessly support large 4K scale-down arrays
          width: targetWidth,
          height: targetHeight,
          bitrate: bitrateTargetKbps * 1000,
          framerate: 30,
        });

        const audioEncoder = new AudioEncoder({
          output: (chunk, metadata) => muxer.addAudioChunk(chunk, metadata),
          error: (err) => reject(err),
        });
        audioEncoder.configure({
          codec: 'mp4a.40.2',
          numberOfChannels: 2,
          sampleRate: 44100,
          bitrate: 128000,
        });

        const audioCtx = new AudioContext({ sampleRate: 44100 });
        const source = audioCtx.createMediaElementSource(video);
        const processor = audioCtx.createScriptProcessor(4096, 2, 2);
        
        source.connect(processor);
        processor.connect(audioCtx.destination);

        processor.onaudioprocess = (e: AudioProcessingEvent) => {
          if (video.paused || video.ended) return;
          const left = e.inputBuffer.getChannelData(0);
          const right = e.inputBuffer.getChannelData(1);
          
          const combinedSamples = new Float32Array(left.length + right.length);
          combinedSamples.set(left, 0);
          combinedSamples.set(right, left.length);

          const timestampUs = Math.round(video.currentTime * 1000000);
          const audioData = new AudioData({
            format: 'f32-planar',
            sampleRate: 44100,
            numberOfFrames: left.length,
            numberOfChannels: 2,
            timestamp: timestampUs,
            data: combinedSamples,
          });

          audioEncoder.encode(audioData);
          audioData.close();
        };

        const duration = video.duration || 1;
        let intervalId: NodeJS.Timeout;

        video.onplay = () => {
          intervalId = setInterval(() => {
            if (video.paused || video.ended) return;

            ctx.drawImage(video, 0, 0, targetWidth, targetHeight);
            const timestampUs = Math.round(video.currentTime * 1000000);
            const frame = new VideoFrame(canvas, { timestamp: timestampUs });
            
            videoEncoder.encode(frame);
            frame.close();

            const p = Math.min(Math.floor((video.currentTime / duration) * 95), 95);
            if (onProgress) {
              onProgress(p, this.calculateTimeRemaining(p, startTime, file.size));
            }
          }, 1000 / 30);
        };

        video.onended = async () => {
          clearInterval(intervalId);
          processor.disconnect();
          source.disconnect();
          
          await videoEncoder.flush();
          await audioEncoder.flush();
          videoEncoder.close();
          audioEncoder.close();
          await audioCtx.close();
          muxer.finalize();

          URL.revokeObjectURL(video.src);
          const bufferTarget = muxer.target as Muxer.ArrayBufferTarget;
          resolve(new Blob([bufferTarget.buffer], { type: 'video/mp4' }));
        };

        video.play().catch(reject);
      };
      video.onerror = () => reject(new Error('Failed to parse incoming mp4 stream layout.'));
    });
  }
}
